@@ -0,0 +1,211 @@
+import { chromium } from 'playwright';
+import fs from 'fs';
+
+const screenshotPath = '/Users/mike/.claude/jobs/e8a4ecde/tmp/labcheck.png';
+const testLogPath = '/tmp/lab/freeq-test.log';
+
+async function getComputedVisibility(page, selector) {
+  try {
+    const element = await page.$(selector);
+    if (!element) return { visible: false, display: 'none', visibility: 'hidden', bbox: null };
+
+    const style = await element.evaluate(el => {
+      const computed = window.getComputedStyle(el);
+      return {
+        display: computed.display,
+        visibility: computed.visibility,
+        opacity: computed.opacity
+      };
+    });
+
+    const bbox = await element.boundingBox();
+
+    const isVisible = style.display !== 'none' &&
+                      style.visibility !== 'hidden' &&
+                      style.opacity !== '0' &&
+                      bbox !== null;
+
+    return {
+      visible: isVisible,
+      display: style.display,
+      visibility: style.visibility,
+      opacity: style.opacity,
+      bbox: bbox
+    };
+  } catch (e) {
+    return { visible: false, error: e.message };
+  }
+}
+
+async function getElementText(page, selector) {
+  try {
+    return await page.textContent(selector) || '';
+  } catch {
+    return '';
+  }
+}
+
+async function runChecks(page, runName) {
+  await page.waitForTimeout(2000);
+
+  const landing = await getComputedVisibility(page, '#landing');
+  const firststeps = await getComputedVisibility(page, '#firststeps');
+  const soundWrap = await getComputedVisibility(page, '#sound-wrap');
+  const soundBtn = await getComputedVisibility(page, '#sound-btn');
+  const musicModes = await getComputedVisibility(page, '#music-modes');
+  const soundPanel = await getComputedVisibility(page, '#sound-panel');
+
+  const memberListText = await getElementText(page, '#members');
+  const audioContextCount = await page.evaluate(() => window.__audioContextCount || 0);
+  const playCount = await page.evaluate(() => window.__playCount || 0);
+
+  const headerLoc = await getElementText(page, 'header .loc');
+  const canvas = await page.$('canvas#world');
+  let canvasDims = { width: 0, height: 0 };
+  if (canvas) {
+    canvasDims = await canvas.evaluate(el => ({
+      width: el.width,
+      height: el.height
+    }));
+  }
+
+  const landingVisible = landing.visible;
+  const hasBluesky = landingVisible;
+  const hasSoundUI = soundWrap.visible || musicModes.visible || soundPanel.visible;
+  const pageText = await page.textContent('body');
+  const hasSoundText = /♪/.test(pageText);
+
+  // Extract first nick from member list (format: "N here◈ nick1◈ nick2...")
+  const firstNickMatch = memberListText.split('\n')[0].match(/◈\s*([a-zA-Z0-9_-]+)/);
+  const displayedNick = firstNickMatch ? firstNickMatch[1] : 'unknown';
+
+  const result = {
+    run: runName,
+    popup: {
+      visible: landing.visible,
+      display: landing.display,
+      visibility: landing.visibility
+    },
+    nick: {
+      memberListText: memberListText.trim().split('\n')[0],
+      displayedNick: displayedNick
+    },
+    firststeps: {
+      visible: firststeps.visible,
+      display: firststeps.display,
+      visibility: firststeps.visibility
+    },
+    audio: {
+      audioContextCount: audioContextCount,
+      playCount: playCount,
+      soundWrapVisible: soundWrap.visible,
+      soundBtnVisible: soundBtn.visible,
+      musicModesVisible: musicModes.visible,
+      soundPanelVisible: soundPanel.visible,
+      hasSoundText: hasSoundText
+    },
+    bluesky: {
+      hasVisibleText: hasBluesky
+    },
+    room: {
+      headerLoc: headerLoc.trim()
+    },
+    canvas: {
+      width: canvasDims.width,
+      height: canvasDims.height,
+      dimensions: `${canvasDims.width}x${canvasDims.height}`
+    }
+  };
+
+  return result;
+}
+
+async function main() {
+  const browser = await chromium.launch({ headless: true });
+  const results = [];
+
+  try {
+    const context = await browser.newContext({
+      viewport: { width: 1920, height: 1080 }
+    });
+
+    // Add init script to count AudioContext and play calls
+    await context.addInitScript(() => {
+      window.__audioContextCount = 0;
+      window.__playCount = 0;
+
+      if (typeof AudioContext !== 'undefined') {
+        const OrigAudioContext = AudioContext;
+        class CountingAudioContext extends OrigAudioContext {
+          constructor(...args) {
+            super(...args);
+            window.__audioContextCount++;
+          }
+        }
+        Object.setPrototypeOf(CountingAudioContext, OrigAudioContext);
+        Object.setPrototypeOf(CountingAudioContext.prototype, OrigAudioContext.prototype);
+        window.AudioContext = CountingAudioContext;
+      }
+
+      const origPlay = HTMLMediaElement.prototype.play;
+      HTMLMediaElement.prototype.play = function(...args) {
+        window.__playCount++;
+        return origPlay.apply(this, args);
+      };
+    });
+
+    const url = `http://localhost:8797/?freeq=ws://127.0.0.1:8081/irc&room=%23the-lab&nick=mike&bare=1&_t=${Date.now()}`;
+
+    // Run 1: Fresh
+    const page1 = await context.newPage();
+    await page1.goto(url, { waitUntil: 'load', timeout: 15000 });
+    const result1 = await runChecks(page1, 'fresh');
+    results.push(result1);
+
+    // Take screenshot from first run
+    await page1.screenshot({ path: screenshotPath, fullPage: true });
+
+    // Run 2: Reload
+    await page1.reload({ waitUntil: 'load', timeout: 15000 });
+    const result2 = await runChecks(page1, 'reload');
+    results.push(result2);
+
+    // Run 3: New page in same context
+    const page2 = await context.newPage();
+    await page2.goto(url, { waitUntil: 'load', timeout: 15000 });
+    const result3 = await runChecks(page2, 'newpage');
+    results.push(result3);
+
+    // Read test log
+    let testLogLines = '';
+    try {
+      if (fs.existsSync(testLogPath)) {
+        const allLog = fs.readFileSync(testLogPath, 'utf-8');
+        const lines = allLog.split('\n');
+        testLogLines = lines
+          .filter(line => /Registered nick|JOIN/.test(line))
+          .slice(-10)
+          .join('\n');
+      }
+    } catch (e) {
+      testLogLines = `Error reading log: ${e.message}`;
+    }
+
+    const finalOutput = {
+      results: results,
+      screenshot: screenshotPath,
+      testLogLines: testLogLines
+    };
+
+    console.log(JSON.stringify(finalOutput, null, 2));
+
+    await context.close();
+  } finally {
+    await browser.close();
+  }
+}
+
+main().catch(err => {
+  console.error('Test failed:', err);
+  process.exit(1);
+});
