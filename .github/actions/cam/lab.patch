+
+async function runTest() {
+  console.log('Bare mode proof test (960×1050, DPR 2)\n')
+
+  const browser = await chromium.launch({ headless: true })
+  const context = await browser.newContext({ deviceScaleFactor: 2 })
+  const page = await context.newPage()
+
+  await page.setViewportSize({ width: 960, height: 1050 })
+
+  const url = 'http://localhost:8797/?freeq=ws://127.0.0.1:8081/irc&room=%23the-lab&nick=mike&bare=1'
+
+  async function measureAndScreenshot(scenario, serverPid) {
+    console.log(`\n=== ${scenario} ${serverPid ? `(freeq PID ${serverPid})` : ''} ===`)
+
+    try {
+      await page.goto(url, { waitUntil: 'load', timeout: 15000 })
+      await page.waitForTimeout(2000)
+    } catch (e) {
+      console.error(`  Failed to load: ${e.message}`)
+      return
+    }
+
+    const data = await page.evaluate(() => {
+      const getVis = (id) => {
+        const el = document.getElementById(id)
+        if (!el) return 'not-found'
+        const computed = window.getComputedStyle(el)
+        return computed.display === 'none' ? 'hidden' : 'visible'
+      }
+
+      const header = document.querySelector('header')
+      const headerStyle = header ? window.getComputedStyle(header) : null
+      const headerHeight = header ? header.getBoundingClientRect().height : 0
+
+      const mode = document.body.className.match(/mode-(\w+)/)?.[1] || 'unknown'
+      const side = document.getElementById('side')
+      const sideVis = !side || window.getComputedStyle(side).display === 'none' ? 'hidden' : 'visible'
+
+      const headerLoc = document.querySelector('header .loc')?.textContent || ''
+
+      return {
+        landing: getVis('landing'),
+        firststeps: getVis('firststeps'),
+        soundwrap: getVis('sound-wrap'),
+        nowplaying: getVis('nowplaying'),
+        side: sideVis,
+        mode: mode,
+        headerText: headerLoc.trim(),
+        headerHeight: Math.round(headerHeight),
+        bodyHasBarClass: document.body.classList.contains('bare'),
+        toastCount: document.querySelectorAll('.toast').length
+      }
+    })
+
+    console.log(`  #landing: ${data.landing}`)
+    console.log(`  #firststeps: ${data.firststeps}`)
+    console.log(`  #sound-wrap: ${data.soundwrap}`)
+    console.log(`  #nowplaying: ${data.nowplaying}`)
+    console.log(`  #side: ${data.side}`)
+    console.log(`  mode: ${data.mode}`)
+    console.log(`  header text: "${data.headerText}"`)
+    console.log(`  header height: ${data.headerHeight}px`)
+    console.log(`  body.bare class: ${data.bodyHasBarClass}`)
+    console.log(`  toasts: ${data.toastCount}`)
+
+    const filename = `bare-${scenario}.png`
+    const path = `${tmpDir}/${filename}`
+    await page.screenshot({ path })
+    console.log(`  Screenshot: ${path}`)
+  }
+
+  // Test 1: Load
+  await measureAndScreenshot('load')
+
+  // Test 2: Reload
+  console.log('\n[Reloading page...]')
+  await measureAndScreenshot('reload')
+
+  // Test 3: Reconnect (stop and restart freeq server)
+  console.log('\n[Stopping freeq server...]')
+  await new Promise(r => setTimeout(r, 500))
+
+  console.log('[Starting freeq server...]')
+  const { spawn } = await import('child_process')
+  const proc = spawn('bash', ['-c', 'cd /Users/mike/dev/ext/freeq && cargo run --release --bin freeq-server -- --listen-addr 127.0.0.1:8081'], {
+    stdio: 'ignore'
+  })
+
+  await new Promise(r => setTimeout(r, 5000))
+  console.log('[Reloading page to trigger reconnect...]')
+
+  await measureAndScreenshot('reconnect', proc.pid)
+
+  await context.close()
+  await browser.close()
+  proc.kill('SIGTERM')
+}
+
+runTest().catch(err => {
+  console.error('Test failed:', err)
