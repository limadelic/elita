+import http from 'http'
+import fs from 'fs'
+import path from 'path'
+import { fileURLToPath } from 'url'
+import net from 'net'
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url))
+
+// Minimal HTTP server for client/dist
+const distPath = path.join(__dirname, 'client/dist')
+const server = http.createServer((req, res) => {
+  const filePath = path.join(distPath, req.url === '/' ? 'index.html' : req.url)
+  fs.readFile(filePath, (err, data) => {
+    if (err) {
+      res.writeHead(404)
+      res.end('Not found')
+      return
+    }
+    res.writeHead(200, { 'Content-Type': 'text/html' })
+    res.end(data)
+  })
+})
+server.listen(8797, '127.0.0.1', () => {
+  console.log('HTTP server on 127.0.0.1:8797')
+  process.stdout.write(JSON.stringify({ httpPid: process.pid }))
+})
+
+// Minimal IRC server for testing
+const ircServer = net.createServer((socket) => {
+  socket.write(`:irc.test 001 user :Welcome\r\n`)
+})
+ircServer.listen(16690, '127.0.0.1', () => {
+  console.log('IRC server on 127.0.0.1:16690')
+})
+
+process.on('SIGTERM', () => {
+  server.close()
+  ircServer.close()
+  process.exit(0)
+})
