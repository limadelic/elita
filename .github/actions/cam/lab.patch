+++ b/e2e/canvas-bare-mode.spec.ts
@@ -0,0 +1,84 @@
+import { expect, test } from '@playwright/test'
+
+// Test bare mode canvas scaling and centering
+// URL: ?freeq=...&room=%23the-lab&nick=mike&bare=1
+test.describe('canvas scaling in bare mode', () => {
+  test('full room visible at 960x1050, canvas centered', async ({ page }) => {
+    // Navigate to bare mode (using dummy URLs that won't connect)
+    const bareUrl = '/?bare=1'
+    await page.goto(bareUrl)
+    
+    // Set viewport size
+    await page.setViewportSize({ width: 960, height: 1050 })
+    
+    // Get canvas element
+    const canvas = page.locator('canvas#world')
+    
+    // Get worldwrap container
+    const worldwrap = page.locator('#worldwrap')
+    
+    // Wait for canvas to render (it should be visible without landing overlay)
+    await expect(canvas).toBeVisible()
+    
+    // Get bounding boxes
+    const canvasBox = await canvas.boundingBox()
+    const wrapBox = await worldwrap.boundingBox()
+    
+    if (!canvasBox || !wrapBox) throw new Error('Could not get bounding boxes')
+    
+    // VIEW_W = 320, VIEW_H = 180
+    // At 960x1050: min(960/320, 1050/180) = min(3, 5.83) = 3
+    // Canvas should be 320*3 = 960px wide, 180*3 = 540px tall
+    expect(canvasBox.width).toBe(960)
+    expect(canvasBox.height).toBe(540)
+    
+    // Canvas should be centered horizontally and vertically
+    // Left margin and right margin should be equal (within 1px)
+    const leftMargin = canvasBox.x - wrapBox.x
+    const rightMargin = (wrapBox.x + wrapBox.width) - (canvasBox.x + canvasBox.width)
+    expect(Math.abs(leftMargin - rightMargin)).toBeLessThanOrEqual(1)
+    
+    // Top margin and bottom margin should be equal (within 1px)
+    const topMargin = canvasBox.y - wrapBox.y
+    const bottomMargin = (wrapBox.y + wrapBox.height) - (canvasBox.y + canvasBox.height)
+    expect(Math.abs(topMargin - bottomMargin)).toBeLessThanOrEqual(1)
+  })
+  
+  test('canvas refits on window resize', async ({ page }) => {
+    const bareUrl = '/?bare=1'
+    await page.goto(bareUrl)
+    
+    const canvas = page.locator('canvas#world')
+    const worldwrap = page.locator('#worldwrap')
+    
+    // Test multiple viewport sizes
+    const sizes = [
+      { width: 1920, height: 600 },   // wide
+      { width: 700, height: 1200 },   // tall
+      { width: 480, height: 360 },    // small
+      { width: 960, height: 1050 },   // target
+      { width: 1920, height: 1080 },  // fullscreen
+    ]
+    
+    for (const size of sizes) {
+      await page.setViewportSize(size)
+      
+      // Wait a frame for resize handler to execute
+      await page.waitForTimeout(50)
+      
+      const canvasBox = await canvas.boundingBox()
+      const wrapBox = await worldwrap.boundingBox()
+      
+      if (!canvasBox || !wrapBox) throw new Error(`Could not get bounding boxes at ${size.width}x${size.height}`)
+      
+      // Verify centering
+      const leftMargin = canvasBox.x - wrapBox.x
+      const rightMargin = (wrapBox.x + wrapBox.width) - (canvasBox.x + canvasBox.width)
+      expect(Math.abs(leftMargin - rightMargin)).toBeLessThanOrEqual(1)
+      
+      const topMargin = canvasBox.y - wrapBox.y
+      const bottomMargin = (wrapBox.y + wrapBox.height) - (canvasBox.y + canvasBox.height)
+      expect(Math.abs(topMargin - bottomMargin)).toBeLessThanOrEqual(1)
+    }
+  })
+})
