diff --git a/check-layout.mjs b/check-layout.mjs
new file mode 100644
index 0000000..b118376
--- /dev/null
+++ b/check-layout.mjs
@@ -0,0 +1,171 @@
+import { chromium } from 'playwright';
+import fs from 'fs';
+import path from 'path';
+
+const tmpDir = '/Users/mike/.claude/jobs/e8a4ecde/tmp';
+const viewports = [
+  { width: 960, height: 1050, name: 'fit-960x1050' },
+  { width: 1920, height: 1080, name: 'fit-1920x1080' },
+  { width: 1280, height: 800, name: 'fit-1280x800' },
+  { width: 800, height: 600, name: 'fit-800x600' }
+];
+
+async function checkLayout(page, viewport) {
+  const result = {
+    viewport: `${viewport.width}x${viewport.height}`,
+    scrollWidth: await page.evaluate(() => document.scrollingElement?.scrollWidth || 0),
+    scrollHeight: await page.evaluate(() => document.scrollingElement?.scrollHeight || 0),
+    innerWidth: await page.evaluate(() => window.innerWidth),
+    innerHeight: await page.evaluate(() => window.innerHeight),
+    noHorizontalScroll: false,
+    noVerticalScroll: false,
+    canvas: null,
+    chatPanel: null,
+    canvasBacking: null,
+    bare: null,
+    errors: []
+  };
+
+  // Check scroll dimensions
+  result.noHorizontalScroll = result.scrollWidth <= result.innerWidth;
+  result.noVerticalScroll = result.scrollHeight <= result.innerHeight;
+
+  // Get canvas info
+  const canvasRect = await page.evaluate(() => {
+    const canvas = document.getElementById('world');
+    if (!canvas) return null;
+    const rect = canvas.getBoundingClientRect();
+    return {
+      x: rect.x,
+      y: rect.y,
+      width: rect.width,
+      height: rect.height,
+      backingWidth: canvas.width,
+      backingHeight: canvas.height,
+      fullsInViewport: rect.x >= 0 && rect.y >= 0 &&
+                       rect.right <= window.innerWidth &&
+                       rect.bottom <= window.innerHeight,
+      aspectRatio: rect.width / rect.height
+    };
+  });
+
+  if (canvasRect) {
+    result.canvas = canvasRect;
+    result.canvasBacking = {
+      width: canvasRect.backingWidth,
+      height: canvasRect.backingHeight,
+      equals1920x1080: canvasRect.backingWidth === 1920 && canvasRect.backingHeight === 1080
+    };
+
+    // Check 16:9 aspect ratio (with 1px tolerance)
+    const expectedAspect = 16/9;
+    result.canvas.aspectRatioOK = Math.abs(result.canvas.aspectRatio - expectedAspect) <= 0.01;
+  } else {
+    result.errors.push('Canvas #world not found');
+  }
+
+  // Get chat panel info
+  const panelRect = await page.evaluate(() => {
+    const panel = document.getElementById('side');
+    if (!panel) return null;
+    const rect = panel.getBoundingClientRect();
+    return {
+      x: rect.x,
+      y: rect.y,
+      width: rect.width,
+      height: rect.height,
+      fullsInViewport: rect.x >= 0 && rect.y >= 0 &&
+                       rect.right <= window.innerWidth &&
+                       rect.bottom <= window.innerHeight
+    };
+  });
+
+  if (panelRect) {
+    result.chatPanel = panelRect;
+  } else {
+    result.errors.push('Chat panel #side not found');
+  }
+
+  // Check bare page requirements
+  const bareState = await page.evaluate(() => ({
+    hasLanding: !document.getElementById('landing')?.classList.contains('hidden'),
+    hasFirststeps: !document.getElementById('firststeps')?.classList.contains('hidden'),
+    hasSoundUI: !document.getElementById('sound-wrap')?.style.display?.includes('none')
+  }));
+
+  result.bare = {
+    noLanding: !bareState.hasLanding,
+    noFirststeps: !bareState.hasFirststeps,
+    hasSoundUI: bareState.hasSoundUI,
+    allGood: !bareState.hasLanding && !bareState.hasFirststeps
+  };
+
+  return result;
+}
+
+async function main() {
+  const results = {};
+
+  try {
+    for (const viewport of viewports) {
+      const browser = await chromium.launch({ headless: true });
+      const context = await browser.newContext({
+        viewport: { width: viewport.width, height: viewport.height }
+      });
+
+      const page = await context.newPage();
+
+      try {
+        const url = 'http://localhost:8797/?freeq=ws://127.0.0.1:8081/irc&room=%23the-lab&nick=labtest&bare=1';
+        await page.goto(url, { waitUntil: 'load', timeout: 15000 });
+        await page.waitForTimeout(1000);
+
+        const result = await checkLayout(page, viewport);
+        results[viewport.name] = result;
+
+        // Take screenshot
+        const screenshotPath = path.join(tmpDir, `${viewport.name}.png`);
+        await page.screenshot({ path: screenshotPath, fullPage: false });
+        result.screenshot = screenshotPath;
+
+        console.log(`✓ ${viewport.name}`);
+      } catch (err) {
+        results[viewport.name] = {
+          viewport: `${viewport.width}x${viewport.height}`,
+          error: err.message
+        };
+        console.error(`✗ ${viewport.name}: ${err.message}`);
+      } finally {
+        await context.close();
+        await browser.close();
+      }
+    }
+
+    // Print results
+    console.log('\n' + '='.repeat(80));
+    for (const [name, result] of Object.entries(results)) {
+      console.log(`\n${name}:`);
+      if (result.error) {
+        console.log(`  ERROR: ${result.error}`);
+      } else {
+        console.log(`  Scroll: H=${result.noHorizontalScroll} V=${result.noVerticalScroll} (${result.scrollWidth}x${result.scrollHeight})`);
+        console.log(`  Canvas backing: ${result.canvasBacking?.width}x${result.canvasBacking?.height} (${result.canvasBacking?.equals1920x1080 ? '✓' : '✗'})`);
+        if (result.canvas) {
+          console.log(`  Canvas CSS: ${result.canvas.width.toFixed(0)}x${result.canvas.height.toFixed(0)} aspect=${result.canvas.aspectRatio.toFixed(3)} (${result.canvas.aspectRatioOK ? '✓' : '✗'})`);
+          console.log(`  Canvas in viewport: ${result.canvas.fullsInViewport ? '✓' : '✗'}`);
+        }
+        if (result.chatPanel) {
+          console.log(`  Chat panel in viewport: ${result.chatPanel.fullsInViewport ? '✓' : '✗'}`);
+        }
+        console.log(`  Bare page: ${result.bare.allGood ? '✓' : '✗'}`);
+      }
+    }
+  } finally {
+    // browsers closed in loop
+  }
+}
+
+main().catch(err => {
+  console.error('Test failed:', err);
+  process.exit(1);
+});
