@@ -0,0 +1,63 @@
+<!DOCTYPE html>
+<html>
+<head>
+  <title>Canvas DPR Test</title>
+  <style>
+    body { margin: 0; padding: 0; background: #000; }
+    #worldwrap { width: 960px; height: 1050px; }
+    #world { display: block; border: 1px solid #fff; image-rendering: pixelated; }
+  </style>
+</head>
+<body>
+  <div id="worldwrap">
+    <canvas id="world"></canvas>
+  </div>
+  <script>
+    // Minimal canvas setup test
+    const CANVAS_W = 1920
+    const CANVAS_H = 1080
+    const VIEW_W = 320
+    const ZOOM = CANVAS_W / VIEW_W
+
+    const canvas = document.getElementById('world')
+    const ctx = canvas.getContext('2d')
+
+    // Simulate fitCanvas
+    const wrap = document.getElementById('worldwrap')
+    const scale = Math.min(wrap.clientWidth / CANVAS_W, wrap.clientHeight / CANVAS_H)
+    const cssWidth = CANVAS_W * scale
+    const cssHeight = CANVAS_H * scale
+    canvas.style.width = `${cssWidth}px`
+    canvas.style.height = `${cssHeight}px`
+
+    const dpr = window.devicePixelRatio || 1
+    const backingWidth = Math.round(cssWidth * dpr)
+    const backingHeight = Math.round(cssHeight * dpr)
+    canvas.width = backingWidth
+    canvas.height = backingHeight
+    ctx.imageSmoothingEnabled = false
+
+    // Store values for testing
+    window.testState = {
+      cssWidth, cssHeight, backingWidth, backingHeight, dpr, scale, ZOOM,
+      canvasWidth: canvas.width,
+      canvasHeight: canvas.height,
+    }
+
+    // Simulate draw - just a filled rectangle
+    ctx.resetTransform()
+    ctx.imageSmoothingEnabled = false
+    ctx.fillStyle = '#000'
+    ctx.fillRect(0, 0, cssWidth, cssHeight)
+
+    // Apply transform (simplified - just the scale part)
+    ctx.setTransform(ZOOM, 0, 0, ZOOM, 0, 0)
+
+    // Draw a test pattern: a white rectangle at world coords (10, 10) with size (20, 20)
+    ctx.fillStyle = '#fff'
+    ctx.fillRect(10, 10, 20, 20)
+
+    console.log('Canvas setup complete. DPR:', dpr, 'Scale:', scale)
+  </script>
+</body>
+</html>
\ No newline at end of file
diff --git a/check-800x600.mjs b/check-800x600.mjs
