+import { expect, test } from '@playwright/test'
+import * as fs from 'fs'
+import * as path from 'path'
+
+const SCREENSHOT_DIR = '/Users/mike/.claude/jobs/e8a4ecde/tmp'
+
+test.describe('canvas resize and centering', () => {
+  test('captures canvas at various viewport sizes', async ({ page, context }) => {
+    // Use deviceScaleFactor 2 for high DPI testing
+    await context.close()
+    const deviceContext = await page.context()
+    
+    // Navigate to the app
+    await page.goto('http://localhost:8787/')
+    
+    // Define viewport sizes to test
+    const sizes = [
+      { width: 1920, height: 600, name: '1920x600' },
+      { width: 700, height: 1200, name: '700x1200' },
+      { width: 480, height: 360, name: '480x360' },
+      { width: 960, height: 1050, name: '960x1050' },
+      { width: 1920, height: 1080, name: '1920x1080' },
+    ]
+    
+    for (const size of sizes) {
+      await page.setViewportSize(size)
+      
+      // Wait for the canvas to render
+      await page.waitForTimeout(200)
+      
+      // Get canvas and container info
+      const canvasBox = await page.locator('canvas#world').boundingBox()
+      const wrapBox = await page.locator('#worldwrap').boundingBox()
