--- /dev/null
+++ b/check-800x600.mjs
@@ -0,0 +1,63 @@
+import { chromium } from 'playwright';
+
+async function check() {
+  const browser = await chromium.launch({ headless: true });
+  const context = await browser.newContext({
+    viewport: { width: 800, height: 600 }
+  });
+
+  const page = await context.newPage();
+  const url = 'http://localhost:8797/?freeq=ws://127.0.0.1:8081/irc&room=%23the-lab&nick=labtest&bare=1';
+  await page.goto(url, { waitUntil: 'load', timeout: 15000 });
+  await page.waitForTimeout(1000);
+
+  const info = await page.evaluate(() => {
+    const canvas = document.getElementById('world');
+    const side = document.getElementById('side');
+    const main = document.querySelector('main');
+    const worldwrap = document.getElementById('worldwrap');
+    
+    const canvasRect = canvas?.getBoundingClientRect();
+    const sideRect = side?.getBoundingClientRect();
+    const mainRect = main?.getBoundingClientRect();
+    const worldwrapRect = worldwrap?.getBoundingClientRect();
+    
+    return {
+      viewport: { innerWidth: window.innerWidth, innerHeight: window.innerHeight },
+      scrolling: {
+        scrollWidth: document.documentElement.scrollWidth,
+        scrollHeight: document.documentElement.scrollHeight
+      },
+      main: mainRect ? {
+        width: mainRect.width, height: mainRect.height,
+        right: mainRect.right, bottom: mainRect.bottom
+      } : null,
+      worldwrap: worldwrapRect ? {
+        width: worldwrapRect.width, height: worldwrapRect.height,
+        right: worldwrapRect.right, bottom: worldwrapRect.bottom,
+        clientWidth: worldwrap?.clientWidth, clientHeight: worldwrap?.clientHeight
+      } : null,
+      canvas: canvasRect ? {
+        width: canvasRect.width, height: canvasRect.height,
+        x: canvasRect.x, y: canvasRect.y,
+        right: canvasRect.right, bottom: canvasRect.bottom,
+        backingWidth: canvas?.width, backingHeight: canvas?.height,
+        canvasWidth: canvas?.style.width, canvasHeight: canvas?.style.height
+      } : null,
+      side: sideRect ? {
+        width: sideRect.width, height: sideRect.height,
+        right: sideRect.right, bottom: sideRect.bottom
+      } : null
+    };
+  });
+
+  console.log(JSON.stringify(info, null, 2));
+
+  await context.close();
+  await browser.close();
+}
+
+check().catch(err => {
+  console.error('Error:', err);
+  process.exit(1);
+});
